{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codo",
  "version": "0.0.1",
  "identifier": "com.renzogabrielsy.codo",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "codo",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "CI charcoal production log",
    "longDescription": "Local desktop event log for CI's charcoal-manufacturing operations. See PROJECT_BRAIN.md."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMzIxQjU1NTJDNDgxRDUKUldUVmdjUlNWUnN5RWsyUzIxb3hpa2JFbWg5MXArdWtPV1cxUDZyVjBIWVF1VFM2TlRubGxjangK",
      "endpoints": [
        "https://github.com/renzogabrielsy/codo/releases/latest/download/latest.json"
      ]
    }
  }
}
